# =============================================================================
# ARMLENQUANT LOCAL POLLER CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# -----------------------------------------------------------------------------
# API Connection
# -----------------------------------------------------------------------------
API_URL=http://127.0.0.1:8000
# For production: API_URL=https://api.yourdomain.com

# Must match AGENT_SECRET in cloud API
AGENT_SECRET=your-agent-secret-here-generate-with-python-c-import-secrets-print-secrets-token-hex-32

AGENT_NAME=LOCAL_POLLER
AGENT_TOKEN=your-agent-token-here
HMAC_KEY=your-base64-encoded-hmac-key-here
HMAC_KEY_VERSION=1

HEADLESS_MODE=true
BROWSER_TIMEOUT=30000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Worker Identity
# -----------------------------------------------------------------------------
WORKER_ID=YOUR_WORKER_ID

# -----------------------------------------------------------------------------
# Polling Configuration
# -----------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=30
TASK_TIMEOUT_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_AUTO_FALLBACK=true

# Google Gemini (DEFAULT)
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Fallback)
OPENAI_API_KEY=your-openai-api-key-optional
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Paths (where outputs are saved)
# -----------------------------------------------------------------------------
JOB_DRAFTS_PATH=~/Job_Drafts
PROJECTS_PATH=~/Projects
CV_PATH=~/Documents/CV/master_cv.md

# -----------------------------------------------------------------------------
# Browser Automation
# -----------------------------------------------------------------------------
HEADLESS_MODE=true
BROWSER_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO